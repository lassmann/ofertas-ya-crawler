generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Supermercados y tiendas
model Store {
  id            String    @id @default(uuid())
  name          String    @unique
  slug          String    @unique
  type          StoreType
  logoUrl       String?
  websiteUrl    String?
  promotionsUrl String?
  isActive      Boolean   @default(true)
  lastScrapedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products   Product[]
  prices     Price[]
  promotions Promotion[]
}

enum StoreType {
  SUPERMERCADO
  FARMACIA
  RESTAURANTE
  ELECTRONICA
  OTRO
}

model Product {
  id                 String   @id @default(uuid())
  name               String
  normalizedName     String
  baseNormalizedName String?  // Name without quantity/unit (e.g., "coca cola original" from "coca cola original 2l")
  brand              String?
  category           String?
  subcategory        String?
  unit               String?  // Normalized unit: "ml", "l", "g", "kg", "un"
  quantity           Float?   // Numeric quantity extracted from name
  barcode            String?  // EAN/UPC - not unique, same product can be in multiple stores
  externalId         String?  // Store's internal product ID (e.g., "12173" from Casa Rica)
  imageUrl           String?
  isHidden           Boolean  @default(false) // Hide incorrectly matched or problematic products
  isAvailable        Boolean  @default(true)  // Product is available/in stock (updated by scraper)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store   Store  @relation(fields: [storeId], references: [id])
  storeId String
  prices  Price[]
  match   ProductMatch?

  @@unique([storeId, normalizedName])
  @@unique([storeId, externalId])
  @@index([normalizedName])
  @@index([baseNormalizedName])
  @@index([storeId])
  @@index([barcode])
}

model Price {
  id        String   @id @default(uuid())
  price     Decimal  @db.Decimal(10, 2)
  oldPrice  Decimal? @db.Decimal(10, 2)
  currency  String   @default("PYG")
  sourceUrl String?
  scrapedAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])
  productId String
  store     Store   @relation(fields: [storeId], references: [id])
  storeId   String

  @@index([productId, scrapedAt])
  @@index([storeId, scrapedAt])
}

model Bank {
  id              String    @id @default(uuid())
  name            String    @unique
  slug            String    @unique
  logoUrl         String?
  websiteUrl      String?
  promotionsUrl   String?
  instagramHandle String?
  isActive        Boolean   @default(true)
  lastScrapedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  promotions Promotion[]
}

model Promotion {
  id              String       @id @default(uuid())
  title           String
  description     String?
  discountPercent Int?
  discountAmount  Decimal?     @db.Decimal(10, 2)
  discountType    DiscountType

  cardTypes   String[]
  minPurchase Decimal? @db.Decimal(10, 2)
  maxDiscount Decimal? @db.Decimal(10, 2)
  daysOfWeek  Int[]

  validFrom DateTime
  validTo   DateTime

  sourceUrl  String?
  imageUrl   String?
  termsUrl   String?
  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  viewsCount  Int @default(0)
  clicksCount Int @default(0)

  scrapedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bank    Bank?   @relation(fields: [bankId], references: [id])
  bankId  String?
  store   Store?  @relation(fields: [storeId], references: [id])
  storeId String?

  @@index([validFrom, validTo])
  @@index([bankId])
  @@index([storeId])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  CUOTAS_SIN_INTERES
  CASHBACK
  OTRO
}

// === MATCHING SYSTEM ===

// Producto canónico - representa UN producto real único
model CanonicalProduct {
  id                 String  @id @default(uuid())
  name               String // Nombre legible: "Coca-Cola Original 2L"
  displayName        String? // Nombre para mostrar al usuario final (si es null, usa name)
  normalizedName     String  @unique
  baseNormalizedName String? // Name without quantity/unit for matching
  brand              String?
  category           String?
  quantity           Float? // Numeric quantity (e.g., 2 for "2L")
  unit               String? // Normalized unit: "ml", "l", "g", "kg", "un"
  primaryBarcode     String? @unique // EAN/UPC principal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches       ProductMatch[]
  aliases       CanonicalAlias[]
  featuredOffer FeaturedOffer?

  @@index([normalizedName])
  @@index([baseNormalizedName])
}

// Alias de nombres conocidos que mapean a un producto canónico
model CanonicalAlias {
  id             String @id @default(uuid())
  normalizedName String @unique // El nombre normalizado de una tienda específica

  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  canonicalProductId String

  createdAt DateTime @default(now())

  @@index([canonicalProductId])
}

// Match entre un Product (de tienda) y un CanonicalProduct
model ProductMatch {
  id         String    @id @default(uuid())
  matchType  MatchType
  confidence Float // 0.0 - 1.0
  isVerified Boolean   @default(false)

  product   Product @relation(fields: [productId], references: [id])
  productId String  @unique

  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  canonicalProductId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canonicalProductId])
  @@index([matchType])
}

enum MatchType {
  BARCODE // 100% confianza - match por EAN/UPC
  ALIAS   // 99% confianza - lookup en tabla de alias
  FUZZY   // 60-95% confianza - pg_trgm similarity
  MANUAL  // 100% confianza - verificado manualmente
}

model PromotionDuplicate {
  id              String   @id @default(uuid())
  promotionId1    String
  promotionId2    String
  similarityScore Float
  isSamePromotion Boolean?
  confirmedBy     String?
  createdAt       DateTime @default(now())

  @@unique([promotionId1, promotionId2])
}

// === FEATURED OFFERS ===

model FeaturedOffer {
  id String @id @default(uuid())

  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  canonicalProductId String           @unique

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}