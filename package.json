    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "pg": "^8.17.2",
    "playwright": "^1.57.0"
  }
