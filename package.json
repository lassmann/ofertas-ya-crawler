{
  "name": "ofertas-ya-crawler",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/jobs/scrape-all.ts",
    "scrape": "tsx src/jobs/scrape-all.ts",
    "scrape:superseis": "tsx src/scrapers/supermercados/superseis.ts",
